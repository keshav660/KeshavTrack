<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>KeshavTrack</title>
    <link rel="stylesheet" href="/style.css" />
</head>
<body>
    <!-- Top Header with Logo and Title -->
    <header>
        <img src="/logo.png" alt="KeshavTrack Logo" />
        <h1>KeshavTrack</h1>
    </header>

    <!-- Card Container: Wraps horizontally and goes down on smaller screens -->
    <div class="card-container">
        <% for (prog of progress) { %>
            <div class="card">
                <div class="card-content">
                    <!-- Date and Work Description -->
                    <h3><%= prog.date %></h3>
                    <h4><%= prog.work %></h4>
                </div>
                <div class="actions">
                    <!-- View Button -->
                    <a class="btn" href="/progress/<%= prog.id %>">🔍 View</a>

                    <!-- Edit Button -->
                    <a class="btn" href="/progress/<%= prog.id %>/edit">✏️ Edit</a>

                    <!-- Delete Form Button -->
                    <form action="/progress/<%= prog.id %>?_method=DELETE" method="POST">
                        <button class="btn danger" onclick="return confirm('Pakka delete karna hai?')">🗑 Delete</button>
                    </form>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Add New Progress Button -->
    <a class="btn" href="/progress/new" style="margin: 20px;">➕ Add New Progress</a>
    <!-- Footer with full-width gradient and centered content -->
    <footer style="
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: linear-gradient(45deg, #7b1fa2, #0097a7);
        color: white;
        padding: 15px 0;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
        font-size: 0.9rem;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.2);
    ">
        <div style="text-align: center;">
            &copy; 2025 KESHAV BHATT
        </div>
        <div style="text-align: center;">
            Email: <a href="mailto:keshavbhatt660@gmail.com" style="color: #ffe082; text-decoration: none;">keshavbhatt660@gmail.com</a>
        </div>
        <div style="text-align: center;">
            LinkedIn: <a href="https://www.linkedin.com/in/keshavbhatt" target="_blank" style="color: #ffe082; text-decoration: none;">linkedin.com/in/keshavbhatt</a>
        </div>
        <div style="text-align: center;">
            GitHub: <a href="https://github.com/keshav660" target="_blank" style="color: #ffe082; text-decoration: none;">github.com/keshav660</a>
        </div>
    </footer>

</body>
</html>
